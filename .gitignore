# --- Blender ---
# Backups automáticos. O .blend do modelo (car-lotus-elise-111s.blend) É versionado.
*.blend1
*.blend2

# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# --- Ambiente virtual / dependências ---
.venv/
venv/
env/

# --- Editores / SO ---
.vscode/*
!.vscode/mcp.json
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Temporários de render ---
# ATENÇÃO: os renders são entregáveis e ficam versionados no workspace:
#   - images/modelo3d-*.png          (galeria de apresentação / README)
#   - docs/renders/*.png             (evidência da verificação visual)
#   - images/*.jpeg                  (referências do cliente, ground truth)
*.png.tmp
*.jpg.tmp
render/
frames/

# Reafirma que as evidências visuais não devem ser ignoradas
!images/*.png
!images/*.jpeg
!docs/renders/*.png

# --- Logs e execução local ---
*.log
.run/

# -----------------------------------------------------------------------------
# LaTeX (monografia/) — artefatos de compilação
# Mantém versionados: .tex, .bib, o PDF final (monografia/main.pdf), figuras,
# diagramas-fonte (.mmd) e o script de build.
# -----------------------------------------------------------------------------
monografia/*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.loq
*.fls
*.fdb_latexmk
*.synctex.gz
*.bcf
*.run.xml
*-blx.bib
latex.out/
.texpadtmp/